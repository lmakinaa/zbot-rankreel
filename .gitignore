# Build outputs (regenerate with the skill-creator packager)
*.skill
*.zip

# Local copies / backups, not source
rankreel_backup/
/rankreel-clip-picker/

# Python / OS noise
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Claude Code per-machine settings
.claude/settings.local.json

# RankReel's own ignores (venv, cache, output, projects, config.json, cookies.txt)
# live in rankreel/.gitignore

# Uploaded sounds stay local except the explicitly selected default sound.
# Built-in vibration sounds and the Core sound effect default are committed.
rankreel/assets/sfx/*
!rankreel/assets/sfx/README.txt
!rankreel/assets/sfx/vibrate.wav
!rankreel/assets/sfx/vibrate_double.wav
!rankreel/assets/sfx/vibrate_heavy.wav
!rankreel/assets/sfx/core_sound_effect.mp3
